# Copy to .env and adjust. .env is not committed to git.

# Port on the host (ignored when published through Traefik, see below).
PORT=8000

# Publish through Traefik (external "proxy" network, HTTPS) instead of the host port.
# COMPOSE_FILE=compose.yaml:compose.traefik.yaml
# MZDY_HOST=mzdy.david.lan

# Creates user "admin" with this password on the first start (when no user exists).
# Remove it afterwards; further users: docker compose exec mzdy python -m payroll.cli create-user NAME
INITIAL_ADMIN_PASSWORD=change-me-to-a-long-password

# Plain HTTP inside a trusted LAN needs this; compose.traefik.yaml forces true (HTTPS).
COOKIE_SECURE=false

# Outgoing mail for payslips.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
